{
  "name": "@openclaw-plugins/agent-repo-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs"
    },
    "./entities": {
      "types": "./entities.d.mts",
      "import": "./entities.mjs"
    },
    "./context-blocks": {
      "types": "./context-blocks.d.mts",
      "import": "./context-blocks.mjs"
    },
    "./maintenance": {
      "types": "./maintenance.d.mts",
      "import": "./maintenance.mjs"
    },
    "./diagnostics": {
      "types": "./diagnostics.d.mts",
      "import": "./diagnostics.mjs"
    }
  },
  "files": [
    "index.mjs",
    "index.d.ts",
    "ui-navigation.mjs",
    "people.mjs",
    "people.d.mts",
    "entities.mjs",
    "entities.d.mts",
    "context-blocks.mjs",
    "context-blocks.d.mts",
    "maintenance.mjs",
    "maintenance.d.mts",
    "diagnostics.mjs",
    "diagnostics.d.mts",
    "workspace-pool.mjs",
    "workspace-lock.mjs"
  ],
  "scripts": {
    "build": "node --check index.mjs && node --check ui-navigation.mjs && node --check people.mjs && node --check entities.mjs && node --check maintenance.mjs && node --check diagnostics.mjs",
    "test": "node --test *.test.mjs",
    "typecheck": "tsc --noEmit --strict --module nodenext --moduleResolution nodenext --target es2022 --skipLibCheck entities.type-test.mts diagnostics.type-test.mts"
  },
  "engines": {
    "node": ">=24.19.0"
  }
}
