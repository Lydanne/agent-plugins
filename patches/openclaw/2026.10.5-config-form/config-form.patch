+// @vitest-environment node
+import { describe, expect, it, vi } from "vitest";
+import type { GatewayBrowserClient } from "../../api/gateway.ts";
+import { isSupportedConfigValueValid } from "../../components/config-form.constraints.ts";
+import bindingSchema from "../../test-helpers/agent-bindings.schema.json" with { type: "json" };
+import { createConfigCapabilityHarness } from "./config-test-harness.ts";
+
+describe("agent binding config.set round trip", () => {
+  it("preserves the complete document on no-op and targeted form saves", async () => {
+    vi.useFakeTimers();
+    const original = {
+      plugins: {
+        entries: {
+          fixture: {
+            enabled: true,
+            config: {
+              agents: {
+                main: {
+                  repo: "/workspace/main",
+                  defaultProject: "example",
+                  sync: {
+                    enabled: true,
+                    preserveLocalMemory: true,
+                    gitEnvironment: { KEEP: "value", ANOTHER: "another" },
+                    submoduleSchedule: { time: "08:00", timeZone: "Asia/Shanghai" },
+                  },
+                },
+                reviewer: { repo: "/workspace/reviewer", defaultProject: "review" },
+              },
+            },
+          },
+        },
+      },
+      unshown: { futureField: ["retain", { nested: true }] },
+    };
+    const schema = {
+      type: "object",
+      properties: {
+        plugins: {
+          type: "object",
+          properties: {
+            entries: {
+              type: "object",
+              properties: {
+                fixture: {
+                  type: "object",
+                  properties: {
+                    enabled: { type: "boolean" },
+                    config: bindingSchema,
+                  },
+                },
+              },
+            },
+          },
+        },
+      },
+    };
+    let persisted = structuredClone(original);
+    let revision = 1;
+    const submissions: unknown[] = [];
+    const request = vi.fn(async (method: string, params?: unknown) => {
+      if (method === "config.get")
+        return {
+          config: persisted,
+          raw: JSON.stringify(persisted),
+          hash: `revision-${revision}`,
+          valid: true,
+          issues: [],
+        };
+      if (method === "config.schema") return { schema, uiHints: {} };
+      if (method === "config.set") {
+        const submission = params as { raw: string; baseHash: string };
+        expect(submission.baseHash).toBe(`revision-${revision}`);
+        const candidate = JSON.parse(submission.raw);
+        expect(isSupportedConfigValueValid(schema, candidate)).toBe(true);
+        submissions.push(candidate);
+        persisted = candidate;
+        revision++;
+        return { config: persisted, hash: `revision-${revision}` };
+      }
+      throw Error(`Unexpected method: ${method}`);
+    });
+    const { runtimeConfig } = createConfigCapabilityHarness(
+      request as GatewayBrowserClient["request"],
+    );
+    try {
+      await Promise.all([runtimeConfig.ensureLoaded(), runtimeConfig.ensureSchemaLoaded()]);
+      await runtimeConfig.save();
+      expect(persisted).toEqual(original);
+      for (const submission of submissions) expect(submission).toEqual(original);
+      runtimeConfig.patchForm(
+        ["plugins", "entries", "fixture", "config", "agents", "main", "repo"],
+        "/workspace/updated",
+      );
+      await expect(runtimeConfig.save()).resolves.toBe(true);
+      const expected = structuredClone(original);
+      expected.plugins.entries.fixture.config.agents.main.repo = "/workspace/updated";
+      expect(submissions.at(-1)).toEqual(expected);
+      expect(persisted).toEqual(expected);
+    } finally {
+      runtimeConfig.dispose();
+    }
+  });
+});
