+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import { page } from "vitest/browser";
+import { i18n } from "../i18n/index.ts";
+import "../styles.css";
+import "../styles/settings.css";
+import {
+  removeConfigFormValue,
+  serializeFormForSubmit,
+  updateConfigFormValue,
+} from "../lib/config/config-draft-model.ts";
+import { createInitialConfigState } from "../lib/config/config-state-model.ts";
+import bindingSchema from "../test-helpers/agent-bindings.schema.json" with { type: "json" };
+import { renderAnalyzedFormFixture } from "../test-helpers/config-form-fixtures.ts";
+import { copyWithPathPatch } from "./config-form-copy-on-write.ts";
+import { isSupportedConfigValueValid } from "./config-form.constraints.ts";
+import { analyzeConfigSchema } from "./config-form.ts";
+
+const fixture = () => ({
+  agents: {
+    main: {
+      repo: "/workspace/main",
+      defaultProject: "example",
+      sync: {
+        enabled: true,
+        timeoutMs: 15000,
+        branch: "main",
+        remote: "origin",
+        preserveLocalMemory: true,
+        inboundChannels: { feishu: { messageIdPrefix: "om_" } },
+        submoduleSchedule: { time: "08:00", timeZone: "Asia/Shanghai" },
+        gitEnvironment: { CUSTOM_ENV: "unchanged", SECOND_ENV: "also unchanged" },
+      },
+    },
+    reviewer: { repo: "/workspace/reviewer", defaultProject: "review" },
+  },
+});
+const schema = { type: "object", properties: { plugin: bindingSchema } };
+
+beforeEach(async () => {
+  await i18n.setLocale("en");
+});
+afterEach(() => document.body.replaceChildren());
+
+describe("agent binding form integrity", () => {
+  it("renders bounded dynamic maps and saves a leaf without losing other fields", async () => {
+    const originalSchema = structuredClone(schema);
+    const analysis = analyzeConfigSchema(schema);
+    expect(schema).toEqual(originalSchema);
+    const state = createInitialConfigState();
+    state.configSchema = schema;
+    const original = { plugin: fixture(), unshown: { futureOption: ["keep", { value: 17 }] } };
+    state.configForm = structuredClone(original);
+    const container = document.createElement("div");
+    document.body.append(container);
+    const renderValue = () =>
+      renderAnalyzedFormFixture(container, analysis, {
+        value: state.configForm,
+        onPatch: (path, value) => updateConfigFormValue(state, path, value),
+        onRemove: (path) => removeConfigFormValue(state, path),
+      });
+    renderValue();
+    await page.screenshot({ path: "agent-bindings-form.png" });
+    expect(analysis.unsupportedPaths).toEqual([]);
+    expect(container.textContent).not.toContain("Unsupported schema node");
+    expect(JSON.parse(serializeFormForSubmit(state))).toEqual(original);
+    const input = container.querySelector<HTMLInputElement>('input[aria-label="Repo"]');
+    expect(input).not.toBeNull();
+    input!.value = "/workspace/updated";
+    input!.dispatchEvent(new Event("input", { bubbles: true }));
+    input!.dispatchEvent(new Event("change", { bubbles: true }));
+    const expected = structuredClone(original);
+    expected.plugin.agents.main.repo = "/workspace/updated";
+    expect(JSON.parse(serializeFormForSubmit(state))).toEqual(expected);
+    expect(isSupportedConfigValueValid(schema, state.configForm)).toBe(true);
+    renderValue();
+    expect(JSON.parse(serializeFormForSubmit(state))).toEqual(expected);
+    expect(original.plugin.agents.main.repo).toBe("/workspace/main");
+    const branch = container.querySelector<HTMLInputElement>('input[aria-label="Branch"]')!;
+    branch.value = "bad..branch";
+    branch.dispatchEvent(new Event("input", { bubbles: true }));
+    branch.dispatchEvent(new Event("change", { bubbles: true }));
+    expect(branch.getAttribute("aria-invalid")).toBe("true");
+    expect(JSON.parse(serializeFormForSubmit(state))).toEqual(expected);
+  });
+
+  it("retains count, key, required, and negative-pattern constraints", () => {
+    const analysis = analyzeConfigSchema(schema);
+    expect(analysis.unsupportedPaths).toEqual([]);
+    const state = createInitialConfigState();
+    state.configSchema = schema;
+    state.configForm = { plugin: fixture() };
+    const base = ["plugin", "agents", "main"];
+    const invalidEdits: Array<[string[], unknown]> = [
+      [[...base, "sync", "branch"], "bad\nbranch"],
+      [[...base, "repo"], "relative/path"],
+      [[...base, "unexpected"], true],
+      [["plugin", "agents", "bad key"], { repo: "/x" }],
+      [[...base, "sync", "inboundChannels"], {}],
+      [[...base, "sync", "gitEnvironment"], { "BAD\nKEY": "x" }],
+      [[...base, "sync", "gitEnvironment"], { GOOD: "bad\u0000value" }],
+      [[...base, "repo"], undefined],
+      [
+        ["plugin", "agents"],
+        Object.fromEntries(
+          Array.from({ length: 101 }, (_, i) => [`agent${i}`, { repo: `/agent/${i}` }]),
+        ),
+      ],
+    ];
+    expect(isSupportedConfigValueValid(analysis.schema!, state.configForm)).toBe(true);
+    for (const [path, value] of invalidEdits) {
+      const candidate = copyWithPathPatch(state.configForm, path, value);
+      expect(candidate.ok).toBe(true);
+      if (candidate.ok) {
+        expect(isSupportedConfigValueValid(schema, candidate.value), path.join(".")).toBe(false);
+        expect(isSupportedConfigValueValid(analysis.schema!, candidate.value), path.join(".")).toBe(
+          false,
+        );
+      }
+    }
+  });
+});
